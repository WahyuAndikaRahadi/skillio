generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String?
  image           String?
  role            String    @default("user")
  is_pro          Boolean   @default(false)
  xp              Int       @default(0)
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]

  roadmaps        UserRoadmap[]
  streak          Streak?
  badges          UserBadge[]
  quiz_results    UserQuizResult[]
  quiz_progress   UserQuizProgress?
  posts           CommunityPost[]
  comments        PostComment[]
  likes           PostLike[]
  ai_mentor_logs  AiMentorLog[]
  group_memberships GroupMember[]
  group_messages  GroupMessage[]
  notifications   Notification[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  icon         String?
  is_generated Boolean  @default(false)

  quizzes      QuizQuestion[]
  roadmap      Roadmap?
  user_roadmaps UserRoadmap[]
  posts        CommunityPost[]
  groups       CommunityGroup[]

  createdAt    DateTime @default(now())
}

model QuizQuestion {
  id             String   @id @default(cuid())
  category_id    String
  phase          Int
  order_number   Int
  question_text  String
  options        Json
  correct_option String?

  category       Category @relation(fields: [category_id], references: [id])

  createdAt      DateTime @default(now())
}

model Roadmap {
  id           String   @id @default(cuid())
  category_id  String   @unique
  title        String
  description  String

  category     Category @relation(fields: [category_id], references: [id])
  user_roadmaps UserRoadmap[]
  file_url     String?  @db.Text

  createdAt    DateTime @default(now())
}

model UserRoadmap {
  id           String   @id @default(cuid())
  user_id      String
  roadmap_id   String
  category_id  String
  status       String   @default("active")
  current_day  Int      @default(1)
  started_at   DateTime @default(now())
  completed_at DateTime?

  user         User     @relation(fields: [user_id], references: [id])
  roadmap      Roadmap  @relation(fields: [roadmap_id], references: [id])
  category     Category @relation(fields: [category_id], references: [id])
  progress     UserDayProgress[]
}

model UserDayProgress {
  id              String   @id @default(cuid())
  user_roadmap_id String
  day_number      Int
  completed_tasks Json     @default("[]")
  tasks_completed Boolean  @default(false)
  quiz_passed     Boolean  @default(false)
  quiz_score      Int?
  proof_card_url  String?
  completed_at    DateTime?

  user_roadmap    UserRoadmap @relation(fields: [user_roadmap_id], references: [id])
}

model Streak {
  id              String   @id @default(cuid())
  user_id         String   @unique
  current_streak  Int      @default(0)
  longest_streak  Int      @default(0)
  last_active     DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [id])
}

model Badge {
  id           String   @id @default(cuid())
  name         String
  description  String
  image_url    String
  type         String
  requirement  Json

  users        UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user_id   String
  badge_id  String
  earned_at DateTime @default(now())
  is_shared Boolean  @default(false)

  user      User     @relation(fields: [user_id], references: [id])
  badge     Badge    @relation(fields: [badge_id], references: [id])
}

model UserQuizResult {
  id         String   @id @default(cuid())
  user_id    String
  phase      Int
  answers    Json
  ai_summary String   @db.Text
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
}

model CommunityPost {
  id           String   @id @default(cuid())
  user_id      String
  category_id  String?
  content      String   @db.Text
  image_url    String?
  type         String
  likes_count  Int      @default(0)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id])
  category     Category? @relation(fields: [category_id], references: [id])
  comments     PostComment[]
  likes        PostLike[]
}

model PostComment {
  id        String   @id @default(cuid())
  post_id   String
  user_id   String
  parent_id String?
  content   String   @db.Text
  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [post_id], references: [id])
  user      User          @relation(fields: [user_id], references: [id])
  parent    PostComment?  @relation("CommentReplies", fields: [parent_id], references: [id])
  replies   PostComment[] @relation("CommentReplies")
}

model PostLike {
  id        String   @id @default(cuid())
  post_id   String
  user_id   String
  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [post_id], references: [id])
  user      User          @relation(fields: [user_id], references: [id])

  @@unique([post_id, user_id])
}

model AiMentorLog {
  id      String   @id @default(cuid())
  user_id String
  date    DateTime @db.Date
  count   Int      @default(0)

  user    User     @relation(fields: [user_id], references: [id])
}

model UserQuizProgress {
  id              String   @id @default(cuid())
  user_id         String   @unique
  current_phase   Int      @default(1)
  current_index   Int      @default(0)
  answers         Json
  ai_questions    Json?
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
}
model CommunityGroup {
  id           String   @id @default(cuid())
  name         String
  description  String   @db.Text
  image_url    String?
  privacy      String   @default("public")
  password     String?
  category_id  String?
  created_by   String
  createdAt    DateTime @default(now())

  category     Category? @relation(fields: [category_id], references: [id])
  members      GroupMember[]
  messages     GroupMessage[]
}

model GroupMember {
  id         String   @id @default(cuid())
  group_id   String
  user_id    String
  role       String   @default("member")
  status     String   @default("approved")
  joined_at  DateTime @default(now())

  group      CommunityGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
}

model GroupMessage {
  id         String   @id @default(cuid())
  group_id   String
  user_id    String
  content    String   @db.Text
  image_url  String?
  file_url   String?
  file_name  String?
  attachments Json?
  createdAt  DateTime @default(now())

  group      CommunityGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  user_id   String
  title     String
  message   String   @db.Text
  type      String   @default("info")
  is_read   Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
